<!DOCTYPE html>
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var isAuthPage = currentPage is "/Login" or "/Registro/Talento" or "/Registro/Empresa";
}
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProviEmplea</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isAuthPage ? "auth-page" : string.Empty)">
    @if (!isAuthPage)
    {
        <header class="site-header">
            <a class="brand" asp-page="/Index">ProviEmplea</a>
            <nav class="site-nav" aria-label="Navegación principal">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    if (User.IsInRole("talento"))
                    {
                        <a asp-page="/Talento/Perfil">Mi perfil</a>
                        <a asp-page="/Talento/Solicitudes">Solicitudes</a>
                    }
                    else if (User.IsInRole("empresa"))
                    {
                        <a asp-page="/Empresa/Perfil">Empresa</a>
                        <a asp-page="/Empresa/Vitrina">Vitrina</a>
                        <a asp-page="/Empresa/Solicitudes">Solicitudes</a>
                    }
                    else if (User.IsInRole("admin"))
                    {
                        <a asp-page="/Admin/Talentos">Validación</a>
                        <a asp-page="/Admin/Solicitudes">Seguimiento</a>
                    }
                    <span class="nav-user">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span>
                    <form method="post" asp-page="/Logout">
                        <button class="btn btn-outline-primary btn-sm" type="submit">Cerrar sesión</button>
                    </form>
                }
                else
                {
                    <a asp-page="/Login">Iniciar sesión</a>
                    <a class="btn btn-primary btn-sm" asp-page="/Registro/Talento">Crear cuenta</a>
                }
            </nav>
        </header>
    }
    <main class="@(isAuthPage ? "auth-main" : string.Empty)">
        @RenderBody()
    </main>
    @if (!isAuthPage)
    {
        <footer class="site-footer">
            Municipalidad de Providencia <span aria-hidden="true">·</span> ProviEmplea
        </footer>
    }
</body>
</html>
