@page "/registro/talento"
@model ProviEmplea.Web.Pages.Registro.TalentoModel
@{
    ViewData["Title"] = "Crear cuenta de talento";
}

<section class="auth-shell register-shell">
    <aside class="auth-aside talent-aside">
        <a class="auth-aside-brand" asp-page="/Index" aria-label="ProviEmplea, inicio">
            <img class="auth-brand-logo" src="~/images/logo-proviemplea.png" alt="ProviEmplea" />
        </a>
        <div>
            <h1>Crea tu perfil laboral y conecta con <span>oportunidades reales</span></h1>
            <p>Únete a miles de vecinos de Providencia que ya encontraron trabajo gracias a ProviEmplea y su sistema de CV Ciego.</p>
            <ul class="benefit-list">
                <li><span aria-hidden="true">✓</span> Perfil laboral gratuito</li>
                <li><span aria-hidden="true">✓</span> CV Ciego para eliminar sesgos</li>
                <li><span aria-hidden="true">✓</span> Validación OMIL Municipal</li>
                <li><span aria-hidden="true">✓</span> Inclusión Ley 21.015</li>
            </ul>
        </div>
        <img class="auth-municipal-logo" src="~/images/logo-providencia.png" alt="Municipalidad de Providencia" />
    </aside>

    <div class="auth-panel">
        <div class="auth-card">
            <a class="auth-back-link" asp-page="/Login"><span aria-hidden="true">←</span> Volver al login</a>
            <a class="auth-mobile-brand" asp-page="/Index" aria-label="ProviEmplea, inicio">
                <img class="auth-brand-logo" src="~/images/logo-proviemplea.png" alt="ProviEmplea" />
            </a>
            <h1>Crear cuenta vecino/a</h1>
            <p class="form-intro">Regístrate con tu correo para comenzar.</p>

            <form method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Input.Correo" class="form-label"></label>
                    <input asp-for="Input.Correo" class="form-control" type="email"
                           autocomplete="email" placeholder="nombre@correo.cl" />
                    <span asp-validation-for="Input.Correo" class="field-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password" class="form-control" type="password"
                           autocomplete="new-password" placeholder="Mínimo 8 caracteres, 1 mayúscula y 1 número" />
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.ConfirmarPassword" class="form-label"></label>
                    <input asp-for="Input.ConfirmarPassword" class="form-control" type="password"
                           autocomplete="new-password" placeholder="Repite tu contraseña" />
                    <span asp-validation-for="Input.ConfirmarPassword" class="field-error"></span>
                </div>
                <div class="notice-box">
                    <span aria-hidden="true">ℹ</span>
                    Tu cuenta quedará <strong>pendiente de validación</strong> hasta que la OMIL Municipal verifique tu certificado de residencia.
                </div>
                <button class="btn btn-primary auth-submit" type="submit">Crear mi cuenta</button>
            </form>

            <p class="auth-switch">
                ¿Ya tienes cuenta? <a asp-page="/Login">Inicia sesión</a>
            </p>
            <p class="auth-copyright">
                © @DateTime.Now.Year Municipalidad de Providencia — ProviEmplea
            </p>
        </div>
    </div>
</section>
